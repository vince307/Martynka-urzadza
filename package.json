{
  "name": "martynka-urzadza",
  "version": "0.1.0",
  "private": true,
  "description": "Martynka urządza: gra matematyczna z urządzaniem pokoi dla klas 1–3 (Phaser 4 + TypeScript + Vite, PWA offline).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vince307/Martynka-urzadza.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample": "node --import tsx scripts/sample.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
