# context/foundation/autonomous-run.env — machine half of the autonomous-run profile.
# Sourced by .claude/skills/10x-autonomous-run/scripts/*.sh (bash 3.2 compatible: no associative arrays).
# Written by the setup interview (references/setup.md) from the same answers as autonomous-run.md § 1–11.
# Commands run from the repo root with `bash -c`. Empty string = this project has no such gate/step.
# NEVER put a secret here — this file is committed.

PROFILE_SKILL_VERSION=6
MAIN_BRANCH="main"

# § 2 local gate — the same steps as .github/workflows/ci.yml, in its order.
GATE_LINT="npm run lint"
GATE_TYPECHECK="npm run typecheck"
PARSE_TYPECHECK=""
GATE_UNIT="npm test && bash deploy/test-martynka-deploy.sh && bash deploy/ops/test-martynka-ops.sh && npm run sample -- E1 && npm run sample -- E2 && npm run sample -- E3 && npm run sample -- E4 && npm run sample -- E5 && npm run sample -- E6"
PARSE_UNIT="Tests +[0-9]+ passed"
GATE_BUILD="npm run build"   # also runs the e2e-hook guard (fails if the hook leaks into dist/)
GATE_DB_TEST=""
PARSE_DB_TEST=""
GATE_SMOKE=""                 # the content smoke (sample E1–E6) needs no server and runs inside GATE_UNIT
PARSE_SMOKE=""
GATE_E2E="npx playwright test"   # local only, never in CI (test-plan.md section 7); webServer builds + serves on 4398; needs the sandbox disabled; also starts the e2e-hook server on 4397 (E2E_HOOK_PORT, not protected)
PARSE_E2E="[0-9]+ passed"
POST_MIGRATION_CMD=""
POST_MIGRATION_ON_DATA_CMD=""

# § 3 dev servers — {port} is substituted.
DEV_CMD="npx vite --config vite/config.dev.mjs --port {port} --strictPort"
DEV_SECOND_INSTANCE_ENV=""
GATE_PORT=4398
VISUAL_PORT=4399
PROTECTED_PORTS="8080 4173 4321 5000 5433 7000 54321 54322 54323 54324 54327"

# § 4 database — none (no backend; progress lives in IndexedDB on the device)
DB_PROVIDER="none"
DB_LOCAL_PROBE=""
DB_LOCAL_RESET=""
DB_MIGRATIONS_DIR=""
DB_HOSTED_AUTH=""
DB_HOSTED_PUSH_DRYRUN=""
DB_HOSTED_PUSH=""
DB_LIST=""
DB_HOSTED_ID=""

# § 5 CI / deploy. CI (job `check`) runs on pull requests only; the Deploy workflow is the one that runs on
# main (lint, typecheck, test, build, deploy with the post-switch smoke), so it decides "red main".
CI_JOBS="build deploy"        # jobs of the Deploy run on the merge sha
CI_WORKFLOW="Deploy"
CI_STATUS_CONTEXT=""
CI_RUN_CMD=""
CI_LOG_CMD=""
DEPLOY_PROVIDER="github-actions+vps"
DEPLOY_CMD=""                 # the merge deploys (push to main runs Deploy)
DEPLOY_WATCH_CMD="gh run watch {run} --repo vince307/Martynka-urzadza --exit-status"
PROD_CURRENT_SHA_CMD=""
PROD_VERIFY_CMD=""            # the Deploy job's "Smoke check (deploy)" step is the verification
PROD_ROLLBACK_CMD=""          # human only: Actions → Deploy → Run workflow → rollback

# § 10 rule files and clean tree (bash arrays)
RULE_FILES=(CLAUDE.md AGENTS.md)
RULE_PATH_ROOTS='\.claude|\.github|src|docs|context|tests|scripts|deploy|public|vite|designs'
RULE_PATH_ALLOW=(public/assets)   # target architecture in CLAUDE.md: art arrives in M7 (src/storage/idb.ts exists since S-11)
TREE_CLEAN_ALLOW=()

# § 11
E2E="on"
RUN_ON_FAILURE="park"
RUN_AUDIT="static"
