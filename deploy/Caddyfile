# Caddyfile template for Martynka urządza. deploy/bootstrap.sh substitutes the
# SITE placeholder (`https://<IPv4>` until a domain is bought, or `<domain>`)
# and the TLS placeholder (`tls { issuer acme { profile shortlived } }` for an IP certificate,
# nothing for a domain). The BIND placeholder is the public IPv4: tailscaled
# already owns port 443 on the tailnet addresses, so Caddy must not bind all interfaces.
__SITE__ {
    bind __BIND__
    root * /srv/martynka/current
    __TLS__
    encode zstd gzip

    # Vite puts hashed bundles under _app/ (build.assetsDir): cache them forever.
    # Unhashed art in public/assets/ keeps the default policy; the service
    # worker precache handles its updates.
    @immutable path /_app/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # Entry points and PWA files must always be revalidated.
    @nocache path / /index.html /sw.js /manifest.webmanifest
    header @nocache Cache-Control "no-cache"

    # Go's MIME table has no .webmanifest entry: set the type by hand.
    header /manifest.webmanifest Content-Type "application/manifest+json"

    file_server
}
